# Server Configuration
VITE_DEV_SERVER_HOST=::
VITE_DEV_SERVER_PORT=7000
VITE_PREVIEW_SERVER_HOST=::
VITE_PREVIEW_SERVER_PORT=7002

# API Configuration
VITE_API_TARGET=https://apipay.wsa-elite.com/
VITE_API_REWRITE_PATH=/api
VITE_API_HEADER_NAME=X-Requested-With
VITE_API_HEADER_VALUE=XMLHttpRequest
npm_package_version=16

# Sanctum Configuration
VITE_SANCTUM_TARGET=https://apipay.wsa-elite.com/

# Allowed Hosts (comma separated)
VITE_ALLOWED_HOSTS=wsa-elite.com,localhost,127.0.0.1,::1,.wsa-elite.com

# Environment
NODE_ENV=production  # ✅ غيرنا دي من development إلى production
VITE_PUBLIC_DIR=./public
PORT=3005